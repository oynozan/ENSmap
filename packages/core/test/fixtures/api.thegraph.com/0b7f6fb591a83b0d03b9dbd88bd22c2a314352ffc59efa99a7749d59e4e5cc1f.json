      "query": "query ResolverChanges($ids: [String!]!, $afterSet: ID!, $afterCleared: ID!) {\n  set: newResolvers(\n    first: 1000\n    orderBy: id\n    where: {\n      and: [\n        { domain_in: $ids }\n        { resolver_not: \"0x0000000000000000000000000000000000000000\" }\n        { id_gt: $afterSet }\n      ]\n    }\n  ) {\n    id\n    blockNumber\n    domain { id }\n    resolver { address }\n  }\n  cleared: newResolvers(\n    first: 1000\n    orderBy: id\n    where: {\n      and: [\n        { domain_in: $ids }\n        { resolver: \"0x0000000000000000000000000000000000000000\" }\n        { id_gt: $afterCleared }\n      ]\n    }\n  ) {\n    id\n    blockNumber\n    domain { id }\n  }\n}",
