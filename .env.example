# Copy to .env and fill in what you need. Every variable is optional; ENSmap
# runs against fixtures (see ENSMAP_FIXTURES) until real credentials are set.
# See docs/spec.md ("Ground rules" and "Spec deviations") for details.

# Alchemy Transfers API and JSON-RPC key. Secret.
ALCHEMY_API_KEY=

# ENSNode instance for mainnet. Reserved, currently unused (spec deviation 1). Secret.
ENSNODE_URL_MAINNET=

# ENSNode instance for sepolia-v2. Reserved, currently unused (spec deviation 1). Secret.
ENSNODE_URL_SEPOLIA_V2=

# Dune API key, for cex.addresses / cex.deposit_addresses label imports. Secret.
DUNE_API_KEY=

# Bitquery Labels API key, for on-demand counterparty classification. Secret.
BITQUERY_API_KEY=

# Postgres connection string (apps/api, packages/db). Secret.
DATABASE_URL=

# graphql.ens.dev API key. Secret.
GRAPH_API_KEY=

# Mainnet ENS data source kind: ens-subgraph | ens-dev-graphql.
ENS_SOURCE_KIND_MAINNET=

# Sepolia-v2 ENS data source kind: ens-subgraph | ens-dev-graphql.
ENS_SOURCE_KIND_SEPOLIA_V2=

# Mainnet ENS data source URL, overrides the default for ENS_SOURCE_KIND_MAINNET. Secret.
ENS_SOURCE_URL_MAINNET=

# Sepolia-v2 ENS data source URL, overrides the default for ENS_SOURCE_KIND_SEPOLIA_V2. Secret.
ENS_SOURCE_URL_SEPOLIA_V2=

# Mainnet (chainId 1) JSON-RPC endpoint; may embed a provider key. Secret.
RPC_URL_1=

# Sepolia-v2 (chainId 11155111) JSON-RPC endpoint; may embed a provider key. Secret.
RPC_URL_11155111=

# Fixture mode: record | replay | off. Defaults to "replay" in tests, so tests never go live unless asked.
ENSMAP_FIXTURES=
