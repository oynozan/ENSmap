# Copy to .env and fill in what you need. Every variable is optional; ENSmap
# runs against fixtures (see ENSMAP_FIXTURES) until real credentials are set.
# See docs/spec.md ("Ground rules" and "Spec deviations") for details.

# --- Alchemy (Transfers API and JSON-RPC) ---
ALCHEMY_API_KEY= # secret

# --- ENSNode (reserved, currently unused; see spec deviation 1) ---
ENSNODE_URL_MAINNET= # secret
ENSNODE_URL_SEPOLIA_V2= # secret

# --- Label sources ---
DUNE_API_KEY= # secret
BITQUERY_API_KEY= # secret

# --- Postgres (apps/api, packages/db) ---
DATABASE_URL= # secret

# --- ENS subgraph / graphql.ens.dev (spec deviation 1 and 2) ---
GRAPH_API_KEY= # secret
# ens-subgraph | ens-dev-graphql
ENS_SOURCE_KIND_MAINNET=
# ens-subgraph | ens-dev-graphql
ENS_SOURCE_KIND_SEPOLIA_V2=
ENS_SOURCE_URL_MAINNET= # secret
ENS_SOURCE_URL_SEPOLIA_V2= # secret

# --- JSON-RPC endpoints, may embed provider keys ---
RPC_URL_1= # secret, mainnet (chainId 1)
RPC_URL_11155111= # secret, sepolia-v2 (chainId 11155111)

# --- Fixtures (record | replay | off); defaults to "replay" in tests ---
ENSMAP_FIXTURES=
