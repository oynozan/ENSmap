{
  "name": "ensmap",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ensmap/api --filter @ensmap/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:drift": "pnpm --filter @ensmap/db exec drizzle-kit generate && test -z \"$(git status --porcelain packages/db/drizzle)\"",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run db:drift && pnpm run test",
    "ensmap": "tsx packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
